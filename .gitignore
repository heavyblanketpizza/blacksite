.venv/
venv/
env/
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.coverage*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/
/models/
*.safetensors
*.gguf

