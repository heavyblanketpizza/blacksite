+@pytest.mark.parametrize("token_param", ["max_tokens", "max_completion_tokens"])
+def test_small_context_reserves_configured_output_limit(token_param):
+    """A 32k server can use its input budget instead of reserving the 64k fallback."""
+    llm = _make_llm(
+        {token_param: 4096}, model="openai/local-vllm", max_context_size=32768
+    )
+    messages = [{"role": "user", "content": "investigate"}]
+    usage = ContextWindowUsage(
+        total_tokens=28672,
+        tools_tokens=0,
+        system_tokens=0,
+        user_tokens=28672,
+        tools_to_call_tokens=0,
+        assistant_tokens=0,
+        other_tokens=0,
+    )
+    with (
+        patch.object(llm, "count_tokens", return_value=usage),
+        patch(
+            "holmes.core.truncation.input_context_window_limiter.ENABLE_CONVERSATION_HISTORY_COMPACTION",
+            False,
+        ),
+    ):
+        result = compact_if_necessary(llm, messages, tools=None)
+        assert result.messages == messages
+        assert result.maximum_output_token == 4096
+        assert not result.conversation_history_compacted
+
+        usage.total_tokens += 1
+        usage.user_tokens += 1
+        with pytest.raises(CompactionInsufficientError):
+            compact_if_necessary(llm, messages, tools=None)
