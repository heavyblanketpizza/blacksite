@@ -790,6 +790,15 @@ class DefaultLLM(LLM):
             raise Exception(f"Unexpected type returned by the LLM {type(result)}")
 
     def get_maximum_output_token(self) -> int:
+        # Match completion's explicit limit so input limiting and compaction
+        # reserve the output budget the request actually uses. A configured
+        # max_completion_tokens takes precedence over max_tokens; null values
+        # are treated as unset, as they are when constructing the request.
+        for param in ("max_completion_tokens", "max_tokens"):
+            configured_limit = self.args.get(param)
+            if configured_limit is not None:
+                return configured_limit
+
         # Reserve output budget = max(64k, 12% of the context window). The 64k
         # floor keeps small and unknown models usable (the 200k fallback window
         # gives 12% = 24k, so they stay at 64k), while large windows scale up:
