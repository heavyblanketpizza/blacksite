+def test_output_budget_matches_configured_limit_before_completion(args, expected):
+    """Per-model limits beat the env default even before the first request."""
+    llm = _make_llm(args, model="openai/local-vllm", max_context_size=32768)
+    with patch("holmes.core.llm.OVERRIDE_MAX_OUTPUT_TOKEN", 12345):
+        assert llm.get_maximum_output_token() == expected
