# Copy to vllm.env at the repository root; pass --env-file vllm.env to Compose.
# These are reference defaults for a Linux NVIDIA host, not a hardware benchmark.
VLLM_IMAGE=vllm/vllm-openai:v0.30.0-cu129
VLLM_MODEL=Qwen/Qwen3-8B
VLLM_TOOL_CALL_PARSER=hermes
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.9
VLLM_MAX_NUM_SEQS=4
VLLM_PORT=8000
# Set the same key on the server, Holmes, and the smoke-check client.
VLLM_API_KEY=local-vllm
# Optional for gated/private models:
# HF_TOKEN=
# Optional Holmes config file with model: vllm and your existing toolsets:
# VLLM_HOLMES_CONFIG_FILE=./examples/vllm/holmes.yaml
